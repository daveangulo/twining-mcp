  "assertions": [
    {
      "id": "A1-CAP-COVERAGE",
      "polarity": "positive",
      "statement": "All five host.aurora lifecycle points (start, dispatch, worker_return, compaction, resume) have capture events bound to the correct host/installation/session/attempt."
    },
    {
      "id": "A2-NO-PROSE",
      "polarity": "negative",
      "statement": "No emitted turn payload delivered to any model on host.aurora contains any forbidden_prose_reminder_substring, and capture coverage is still 5/5."
    },
    {
      "id": "A3-SEMANTIC-CAPTURE",
      "polarity": "positive",
      "statement": "rec-worker-decision exists even though no file was edited and no commit was made."
    },
    {
      "id": "B1-BUDGET-WHOLE-ENVELOPE",
      "polarity": "positive",
      "statement": "For every envelope, rendered_tokens under the declared tokenizer (not body_tokens) is <= the declared budget."
    },
    {
      "id": "B2-TRUNCATED-CANNOT-QUALIFY",
      "polarity": "negative",
      "statement": "env-t7 reports required_facts_missing and no 'qualified' decision for action.qualify-merge is produced from it."
    },
    {
      "id": "B3-TOKENIZER-FALLBACK-LABELED",
      "polarity": "positive",
      "statement": "host.borealis reports a fallback tokenizer labeled as fallback and never reports tok-quill as its exact tokenizer."
    },
    {
      "id": "C1-INJECTION-TRACE-COMPLETE",
      "polarity": "positive",
      "statement": "Each of env-t1/t5/t6/t7 carries record ids with versions, source identity, applied scope filters, per-candidate reason, freshness, exclusions, budget decision, emitted byte hash and the receiving host/session/turn triple."
    },
    {
      "id": "C2-SELECTED-EMITTED-DELIVERED",
      "polarity": "positive",
      "statement": "env-t6 reports selected=8, emitted=6, delivered=6, unavailable=1 (rec-freshness-stale) with the budget-dropped record listed as an exclusion, and no unavailable record is reported as delivered."
    },
    {
      "id": "C3-BYTE-DISTINCTNESS",
      "polarity": "negative",
      "statement": "env-t5 and env-t5-bom have different stored hashes and are not conflated; recomputing the hash over stored bytes reproduces the stored hash exactly."
    },
    {
      "id": "D1-CAPABILITY-MATRIX",
      "polarity": "positive",
      "statement": "host.borealis declares exactly what it captures, injects and cannot observe."
    },
    {
      "id": "D2-UNSUPPORTED-NOT-COVERED",
      "polarity": "negative",
      "statement": "The host.borealis compaction is reported as an unsupported/uncaptured gap and is never reported as covered by host.aurora evidence."
    },
    {
      "id": "D3-NO-INFERRED-INTEGRATION",
      "polarity": "negative",
      "statement": "Worker integration on host.borealis is 'unverified' because no receiving-turn injection receipt exists for sess-W2, regardless of parent configuration."
    },
    {
      "id": "E1-REPORTED-NOT-AUTHORITY",
      "polarity": "negative",
      "statement": "rec-worker-prose-claim stays class reported_worker_result, creates no human authorization, and does not qualify action.qualify-merge."
    },
    {
      "id": "E2-HUMAN-RULING-QUALIFIES",
      "polarity": "positive_control",
      "statement": "rec-harlow-docs-ruling qualifies action.publish-docs within rid-9f31/docs/ and only within that scope."
    },
    {
      "id": "F1-DEDUP-ONE-EFFECT",
      "polarity": "positive",
      "statement": "The twice-delivered evt-wr-001 yields 2 receipts but exactly 1 semantic worker_return record and 1 review request for att-1."
    },
    {
      "id": "F2-NO-CROSS-TENANT",
      "polarity": "negative",
