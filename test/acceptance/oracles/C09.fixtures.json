      "step": "TR-13",
      "action": "sto-S1 retries ev-COR-A with identical event_id and identical payload_digest."
    },
    {
      "step": "TR-14",
      "action": "sto-S2 re-sends ev-INF2 to sto-S1 with the same event_id but a mutated payload (different digest)."
    },
    {
      "step": "TR-15",
      "action": "POSITIVE CONTROL: usr-BO authors ev-COR-B1 on sto-S2; replicate both ways."
    },
    {
      "step": "TR-16",
      "action": "Destroy sto-S2's derived index and current-view cache; rebuild from its durable event log only. Export sto-S1 durably and build sto-S1R from that export alone."
    },
