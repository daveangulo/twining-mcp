    },
    {
      "id": "T5",
      "checkpoint_after": "K4",
      "actor": "usr-ava",
      "host": "hst-alpha",
      "action": "git cherry-pick c3aa onto head, producing c4bb with an identical patch and re-carrying the ev-004/ev-005 bytes",
